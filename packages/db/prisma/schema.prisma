// Driver adapters + WASM query compiler (stable by default in this Prisma
// version, no preview flag needed): no native/per-OS query-engine binary at
// all. Needed because Amplify Gen 2 controls the esbuild bundling config for
// us (defineFunction exposes no way to mark packages external or copy binary
// assets), so the usual binaryTargets fix - which requires the bundler to
// physically copy a .so.node file next to the bundle - isn't reachable from
// this project. See src/client.ts for the PrismaPg adapter wiring. Same
// reasoning as the argon2 -> hash-wasm swap in lib/password.ts.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentMode {
  in_depth
  normal
  concise

  @@map("content_mode")
}

enum TopicStatus {
  not_started
  in_progress
  completed

  @@map("topic_status")
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

enum ExamDifficulty {
  easy
  medium
  hard
  mixed

  @@map("exam_difficulty")
}

enum QuestionSource {
  manual
  uploaded
  ai_generated

  @@map("question_source")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

enum UploadStatus {
  processing
  ready
  failed

  @@map("upload_status")
}

enum FeedbackMode {
  immediate
  end_of_set

  @@map("feedback_mode")
}

enum LiveExamPhase {
  lobby
  question
  reveal
  completed
  cancelled

  @@map("live_exam_phase")
}

// Three tiers: `user` (default), `admin` (curates content, views user
// progress; granted by a super_admin, never self-service), `super_admin`
// (everything admin can do, plus can grant/revoke admin and view OTP codes —
// set directly in the DB/seed, never via a self-service or admin-grantable
// endpoint, same "no self-service admin signup" principle the spec applies
// to the original two-role model).
enum Role {
  user
  admin
  super_admin

  @@map("role")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  role               Role      @default(user)
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz
  anthropicApiKeyEnc Bytes?    @map("anthropic_api_key_enc")
  anthropicApiKeyIv  Bytes?    @map("anthropic_api_key_iv")
  anthropicKeyLast4  String?   @map("anthropic_key_last4")
  onboardingPromptSeenAt DateTime? @map("onboarding_prompt_seen_at") @db.Timestamptz
  lastCertificationCode String? @map("last_certification_code")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  topicProgress   UserTopicProgress[]
  documentUploads DocumentUpload[]
  exams           Exam[]
  createdQuestions Question[]         @relation("QuestionCreatedBy")
  liveExamsHosted        LiveExam[]            @relation("LiveExamHost")
  liveExamParticipations LiveExamParticipant[]

  @@map("users")
}

// Encrypted (AES-256-GCM), not hashed, by explicit project-owner request: a
// super_admin needs to be able to view a user's current OTP (e.g. to read it
// out to someone who didn't receive the email). This is a deliberate
// deviation from the spec's "stored as a hash, never plaintext" (Section 12)
// - see README "Deviations". For a 6-digit code this trades little real
// security versus a hash (the keyspace is small enough that a hash provides
// no meaningful protection beyond the encryption key itself either way).
model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeEnc    Bytes     @map("code_enc")
  codeIv     Bytes     @map("code_iv")
  purpose    String    @default("registration")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("otp_codes")
}

// Persisted rate-limit tracking for login attempts. Required because the
// Lambda is stateless across invocations (no in-memory limiter is possible) —
// see spec Section 12's login rate-limit requirement.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@map("login_attempts")
}

model Certification {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  topics   Topic[]
  questions Question[]
  exams    Exam[]
  liveExams LiveExam[]

  @@map("certifications")
}

model Topic {
  id              String  @id @default(uuid()) @db.Uuid
  certificationId String  @map("certification_id") @db.Uuid
  parentTopicId   String? @map("parent_topic_id") @db.Uuid
  title           String
  orderIndex      Int     @map("order_index")
  examDomain      String? @map("exam_domain")

  certification Certification @relation(fields: [certificationId], references: [id])
  parentTopic   Topic?  @relation("TopicToSubtopic", fields: [parentTopicId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subtopics     Topic[] @relation("TopicToSubtopic")

  content        TopicContent[]
  userProgress   UserTopicProgress[]
  questions      Question[]
  examScopedExams Exam[]
  liveExamScopedExams LiveExam[]

  @@map("topics")
}

model TopicContent {
  id         String      @id @default(uuid()) @db.Uuid
  topicId    String      @map("topic_id") @db.Uuid
  mode       ContentMode
  contentMd  String      @map("content_md")
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, mode])
  @@map("topic_content")
}

model UserTopicProgress {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  topicId      String       @map("topic_id") @db.Uuid
  status       TopicStatus  @default(not_started)
  lastMode     ContentMode? @map("last_mode")
  lastViewedAt DateTime?    @map("last_viewed_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topic_progress")
}

model Question {
  id              String         @id @default(uuid()) @db.Uuid
  certificationId String         @map("certification_id") @db.Uuid
  topicId         String         @map("topic_id") @db.Uuid
  difficulty      Difficulty
  questionText    String         @map("question_text")
  source          QuestionSource
  createdBy       String?        @map("created_by") @db.Uuid
  isActive        Boolean        @default(true) @map("is_active")
  reviewStatus    ReviewStatus   @default(approved) @map("review_status")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  certification Certification    @relation(fields: [certificationId], references: [id])
  topic         Topic            @relation(fields: [topicId], references: [id])
  creator       User?            @relation("QuestionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  liveExamQuestions LiveExamQuestion[]

  @@map("questions")
}

model QuestionOption {
  id          String  @id @default(uuid()) @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  optionText  String  @map("option_text")
  isCorrect   Boolean @map("is_correct")
  explanation String
  orderIndex  Int     @map("order_index")

  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examQuestions ExamQuestion[]
  liveExamAnswers LiveExamAnswer[]

  @@map("question_options")
}

model DocumentUpload {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  filename            String
  storagePath         String       @map("storage_path")
  status              UploadStatus @default(processing)
  generatedQuestionCt Int          @default(0) @map("generated_question_ct")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("document_uploads")
}

model Exam {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  certificationId String         @map("certification_id") @db.Uuid
  feedbackMode    FeedbackMode   @map("feedback_mode")
  difficulty      ExamDifficulty
  topicScope      String?        @map("topic_scope") @db.Uuid
  questionCount   Int            @map("question_count")
  isAssessment    Boolean        @default(false) @map("is_assessment")
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz
  scorePct        Decimal?       @map("score_pct")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  certification Certification  @relation(fields: [certificationId], references: [id])
  scopedTopic   Topic?         @relation(fields: [topicScope], references: [id])
  examQuestions ExamQuestion[]

  @@map("exams")
}

model ExamQuestion {
  id                String    @id @default(uuid()) @db.Uuid
  examId            String    @map("exam_id") @db.Uuid
  questionId        String    @map("question_id") @db.Uuid
  orderIndex        Int       @map("order_index")
  selectedOptionId  String?   @map("selected_option_id") @db.Uuid
  isCorrect         Boolean?  @map("is_correct")
  answeredAt        DateTime? @map("answered_at") @db.Timestamptz

  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@map("exam_questions")
}

// Host-controlled, synchronized multi-user session - everyone joined moves
// through the same question set in lockstep, unlike the self-paced `Exam`
// model above. `phase`/`currentIndex`/`phaseStartedAt` together are the
// entire state machine: clients derive their countdown from `phaseStartedAt`
// and independently call the advance endpoint when it elapses, but a
// conditional update (`WHERE phase = <expected>`) means only the first
// caller actually transitions - see `liveExams.ts`.
model LiveExam {
  id              String        @id @default(uuid()) @db.Uuid
  certificationId String        @map("certification_id") @db.Uuid
  topicScope      String?       @map("topic_scope") @db.Uuid
  difficulty      ExamDifficulty
  requestedCount  Int           @map("requested_count")
  answerSeconds   Int           @map("answer_seconds")
  revealSeconds   Int           @map("reveal_seconds")
  phase           LiveExamPhase @default(lobby)
  currentIndex    Int           @default(0) @map("current_index")
  phaseStartedAt  DateTime?     @map("phase_started_at") @db.Timestamptz
  hostId          String        @map("host_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  startedAt       DateTime?     @map("started_at") @db.Timestamptz
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz

  host          User           @relation("LiveExamHost", fields: [hostId], references: [id], onDelete: Restrict)
  certification Certification  @relation(fields: [certificationId], references: [id])
  scopedTopic   Topic?         @relation(fields: [topicScope], references: [id])
  questions     LiveExamQuestion[]
  participants  LiveExamParticipant[]
  connections   LiveExamConnection[]

  @@map("live_exams")
}

model LiveExamQuestion {
  id         String @id @default(uuid()) @db.Uuid
  liveExamId String @map("live_exam_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  orderIndex Int    @map("order_index")

  liveExam LiveExam         @relation(fields: [liveExamId], references: [id], onDelete: Cascade)
  question Question         @relation(fields: [questionId], references: [id])
  answers  LiveExamAnswer[]

  @@unique([liveExamId, orderIndex])
  @@map("live_exam_questions")
}

model LiveExamParticipant {
  id         String   @id @default(uuid()) @db.Uuid
  liveExamId String   @map("live_exam_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz

  liveExam LiveExam         @relation(fields: [liveExamId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers  LiveExamAnswer[]

  @@unique([liveExamId, userId])
  @@map("live_exam_participants")
}

model LiveExamAnswer {
  id                 String   @id @default(uuid()) @db.Uuid
  liveExamQuestionId String   @map("live_exam_question_id") @db.Uuid
  participantId      String   @map("participant_id") @db.Uuid
  selectedOptionId   String?  @map("selected_option_id") @db.Uuid
  isCorrect          Boolean  @map("is_correct")
  answeredAt         DateTime @default(now()) @map("answered_at") @db.Timestamptz

  liveExamQuestion LiveExamQuestion    @relation(fields: [liveExamQuestionId], references: [id], onDelete: Cascade)
  participant      LiveExamParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption?     @relation(fields: [selectedOptionId], references: [id])

  @@unique([liveExamQuestionId, participantId])
  @@map("live_exam_answers")
}

// One row per open WebSocket connection - the broadcast address book.
// `$connect` inserts, `$disconnect` deletes; a stale row (client vanished
// without a clean close) is pruned lazily when a broadcast to it 410s.
model LiveExamConnection {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @unique @map("connection_id")
  liveExamId   String   @map("live_exam_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  connectedAt  DateTime @default(now()) @map("connected_at") @db.Timestamptz

  liveExam LiveExam @relation(fields: [liveExamId], references: [id], onDelete: Cascade)

  @@map("live_exam_connections")
}
