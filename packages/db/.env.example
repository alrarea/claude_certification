# Copy to .env and fill in the real values. Never commit .env.
# Plain connection string - no sslmode/connection_limit query params needed.
# src/client.ts configures TLS and pool size (max 2 connections - the Lambda
# is not VPC-attached, so concurrent invocations each open their own
# short-lived connection to the same Postgres instance, see spec Section 5)
# explicitly via the pg driver adapter instead, since node-postgres treats
# sslmode=require as an alias for verify-full (fails against RDS's cert
# chain) and doesn't understand connection_limit at all.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Only needed to run prisma/seed.ts (creates the first super_admin account).
SUPER_ADMIN_INITIAL_PASSWORD=
