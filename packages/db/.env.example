# Copy to .env and fill in the real values. Never commit .env.
# connection_limit kept low: the Lambda is not VPC-attached, so concurrent
# invocations each open their own short-lived connection to the same Postgres
# instance (see spec Section 5).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require&connection_limit=2"

# Only needed to run prisma/seed.ts (creates the first super_admin account).
SUPER_ADMIN_INITIAL_PASSWORD=
