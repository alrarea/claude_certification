{
  "name": "claude_certification",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/db",
    "packages/shared"
  ],
  "scripts": {
    "sandbox": "ampx sandbox",
    "deploy": "ampx pipeline-deploy",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "tsx amplify/functions/api/dev-server.ts",
    "db:migrate": "npm run migrate:deploy --workspace=@claude-cert/db",
    "db:generate": "npm run generate --workspace=@claude-cert/db",
    "db:seed": "npm run seed --workspace=@claude-cert/db",
    "db:migrate-guides": "npm run migrate:guides --workspace=@claude-cert/db"
  },
  "dependencies": {
    "@claude-cert/db": "*",
    "@claude-cert/shared": "*",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "hash-wasm": "^4.12.0",
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.7.1",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^26.1.1"
  }
}
